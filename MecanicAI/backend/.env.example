# Variables para desarrollo local. Copia este fichero a backend/.env (lo lee Spring Boot al arrancar).
# NUNCA subas .env a git.

# Clave de la API de Gemini (gratis en https://aistudio.google.com/apikey).
# Si la dejas vacía, en el perfil dev la IA funciona en MODO DEMO (respuestas de ejemplo).
GEMINI_API_KEY=

# Login con Google (opcional en local: sin esto aparece el botón "Entrar con cuenta demo")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Modelos de IA en orden de preferencia (opcional; valores por defecto en application.yml).
# Si el primero está saturado, la app prueba automáticamente el siguiente.
# GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# GEMINI_ENGINES_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
