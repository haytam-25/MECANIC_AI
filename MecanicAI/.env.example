# Variables para compose.yaml (producción). Copia este fichero a .env y rellénalo. NUNCA subas .env a git.

# Tu dominio, sin https:// ni www, ya apuntando a la IP del servidor (registros DNS tipo A de @ y de www).
# Caddy saca el certificado HTTPS solo y redirige www.tudominio → tudominio.
DOMAIN=mecanicai.org

# Otros dominios que redirigen al principal (opcional), separados por espacios y ya apuntando al servidor
# REDIRECT_DOMAINS=mecanicai.es www.mecanicai.es

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 48
JWT_SECRET=

# Contraseña de PostgreSQL. Genera una con: openssl rand -base64 24
DB_PASSWORD=

# Login con Google (ver README → "Configurar el login con Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo saliente para los avisos de caducidad de la ITV y el seguro (opcional: sin MAIL_HOST no se envían).
# Sirve cualquier SMTP (Brevo, Resend, Amazon SES, Gmail con contraseña de aplicación…). Puerto 587 = STARTTLS,
# 465 = TLS directo. El remitente debe ser una dirección verificada en tu proveedor (por defecto avisos@DOMAIN).
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=MecanicAI <avisos@mecanicai.org>

# Días que se guardan las copias de seguridad diarias de backups/ (opcional; la política de privacidad dice 14)
# BACKUP_KEEP_DAYS=14
